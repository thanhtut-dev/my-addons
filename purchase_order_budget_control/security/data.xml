<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.module.category" id="module_purchase_order_budget_control">
            <field name="name">Purchase Budget Control</field>
            <field name="sequence">11</field>
        </record>

        <record id="group_apply_department_filter_po" model="res.groups">
            <field name="name">Apply Department Filter in Purchase</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="po_department_filter" model="ir.rule">
            <field name="name">PO Filtered By Department</field>
            <field ref="model_purchase_order" name="model_id"/>
            <field name="domain_force">[('department_id', '=', user.employee_id.department_id.id)]</field>
            <field name="groups" eval="[(6, 0, [ref('group_apply_department_filter_po')])]"/>
        </record>

    </data>

</odoo>
