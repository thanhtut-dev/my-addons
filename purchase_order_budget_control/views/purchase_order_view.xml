<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_purchase_order_form_inherit_purchase_budget" model="ir.ui.view">
    <field name="name">view.purchase.order.form.inherit.purchase.budget</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook/page[@name='purchase_delivery_invoice']/group/group/field[@name='user_id']" position="after">
          <field name="department_id"/>
      </xpath>
    </field>
  </record>
</odoo>
