<odoo>
  <record id="view_employee_form_inherit_pos_control_buttons_access" model="ir.ui.view">
    <field name="name">view.employee.form.inherit.pos.control.buttons.access</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='hr_settings']" position="inside">
          <group>
            <group string="POS Control Buttons Access" name="pos_control_buttons_access">
                <field name="enable_pos_refund_buttons"/>
                <field name="enable_pos_discount_buttons"/>
            </group>
          </group>
      </xpath>
    </field>
  </record>
</odoo>
