<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_control_buttons.NumpadWidget" t-inherit="point_of_sale.NumpadWidget" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('mode-button')][2]" position="replace">

            <button class="mode-button" t-att-class="{
                        'selected-mode': props.activeMode === 'discount',
                        'disabled-mode': !hasManualDiscount || !this.pos.cashier.enable_pos_discount_buttons
                    }"
                    t-att-disabled="!hasManualDiscount || !this.pos.cashier.enable_pos_discount_buttons"
                    t-on-click="() => this.changeMode('discount')">% Disc</button>
        </xpath>
    </t>

</templates>
